# Copy this file to .env.local and fill in the values from:
#   Firebase console -> Project settings -> General -> Your apps -> SDK setup
#
# These are NOT secrets. They ship in the public JS bundle. Access control is
# enforced by firestore.rules and Firebase Auth, not by keeping these hidden.
# .env.local is gitignored simply to keep project-specific config out of git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
